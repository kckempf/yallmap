# Server
# Note: Langfuse Docker Compose also uses :3000 — run the gateway on a different port
PORT=3001

# Langfuse OTel endpoint
# Local Docker: http://localhost:3000/api/public/otel/v1/traces
# Self-hosted:  https://<host>/api/public/otel/v1/traces
# Cloud:        https://cloud.langfuse.com/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces

# Option A: Langfuse-specific convenience vars (gateway builds Basic auth header)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Option B: Standard OTel headers (takes precedence if LANGFUSE_* not set)
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(publicKey:secretKey)>

# Anthropic upstream (override for testing)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Retry behaviour
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
# Max time we'll honor an upstream Retry-After header before clamping (ms)
RETRY_AFTER_MAX_MS=300000

# Upstream timeouts (mirrors undici's headersTimeout / bodyTimeout)
# Time to wait for the first response byte from the upstream provider (ms)
UPSTREAM_HEADERS_TIMEOUT_MS=30000
# Time to wait for the full response body from the upstream provider (ms)
UPSTREAM_BODY_TIMEOUT_MS=300000

# Graceful shutdown
# Max time to wait for in-flight requests to drain on SIGTERM/SIGINT before
# forcing socket close (ms). Stays under ECS's default 30s SIGKILL window.
SHUTDOWN_TIMEOUT_MS=25000

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Authentication (comma-separated label:secret pairs)
# Clients authenticate with `x-gateway-key: <secret>`. When unset, the gateway is
# unauthenticated — fine for local development, dangerous in production.
# GATEWAY_API_KEYS=alice:secret123,bob:secret456

# Maximum request body size in bytes (default: 4 MB)
# MAX_BODY_BYTES=4194304

# Opt in to capturing prompt and completion content in Langfuse traces.
# Off by default; message content stays out of telemetry. Clients may also opt
# in per-request via the `x-capture-content: true` request header (OR'd with
# this env var) — useful when only some applications want content captured.
# CAPTURE_CONTENT=true
