{
  "name": "yallmap",
  "version": "0.8.0",
  "description": "Anthropic-native LLM gateway with Langfuse OTel observability",
  "private": true,
  "license": "MIT",
  "author": "Kevin Kempf",
  "repository": { "type": "git", "url": "https://github.com/kckempf/yallmap" },
  "homepage": "https://github.com/kckempf/yallmap#readme",
  "bugs": { "url": "https://github.com/kckempf/yallmap/issues" },
  "keywords": ["anthropic", "claude", "claude-code", "llm", "proxy", "gateway", "opentelemetry", "langfuse", "observability", "ollama"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env --require tsx/cjs --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-pricing": "tsx scripts/update-pricing.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "hono": "^4.12.28",
    "pino": "^10.3.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
