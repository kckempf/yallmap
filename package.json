{
  "name": "yallmap",
  "version": "0.8.0",
  "description": "Anthropic-native LLM gateway with Langfuse OTel observability",
  "private": true,
  "license": "MIT",
  "author": "Kevin Kempf",
  "repository": {
    "type": "git",
    "url": "https://github.com/kckempf/yallmap"
  },
  "homepage": "https://github.com/kckempf/yallmap#readme",
  "bugs": {
    "url": "https://github.com/kckempf/yallmap/issues"
  },
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "llm",
    "proxy",
    "gateway",
    "opentelemetry",
    "langfuse",
    "observability",
    "ollama"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --require tsx/cjs --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-pricing": "tsx scripts/update-pricing.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
